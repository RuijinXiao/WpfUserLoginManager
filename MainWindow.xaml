<Window x:Class="WpfUserLoginManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录"
        Height="450"
        Width="380"
        MinHeight="360"
        MinWidth="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/account.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}" MouseLeftButtonDown="WindowRoot_OnMouseLeftButtonDown">
        <Border Margin="26"
                Padding="26"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#29313D"
                BorderThickness="1"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="登录" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />

                <TextBlock Text="用户名" Foreground="{StaticResource MutedTextBrush}" Margin="0,26,0,8" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Visibility="{Binding RequirePassword, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="密码" Foreground="{StaticResource MutedTextBrush}" Margin="0,18,0,8" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_OnPasswordChanged" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FF5C5C"
                           MinHeight="24"
                           Margin="0,12,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="登录"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding LoginCommand}"
                            Height="42" />
                    <Button Grid.Column="2"
                            Content="退出"
                            Height="42"
                            Click="ExitButton_OnClick" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>

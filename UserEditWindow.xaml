<Window x:Class="WpfUserLoginManager.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Height="430"
        Width="420"
        MinHeight="430"
        MinWidth="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/account-plus.ico">
    <Grid Background="{StaticResource AppBackgroundBrush}" MouseLeftButtonDown="WindowRoot_OnMouseLeftButtonDown">
        <Border Margin="22"
                Padding="24"
                Background="{StaticResource PanelBrush}"
                BorderBrush="#29313D"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="用户名" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8" />
                    <TextBox x:Name="UserNameInput" />

                    <TextBlock Text="密码" Foreground="{StaticResource MutedTextBrush}" Margin="0,18,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="PasswordInput"
                                     Grid.Column="0"
                                     PasswordChar="*"
                                     PasswordChanged="PasswordInput_OnPasswordChanged" />
                        <TextBox x:Name="PasswordTextInput"
                                 Grid.Column="0"
                                 Visibility="Collapsed"
                                 TextChanged="PasswordTextInput_OnTextChanged" />
                        <Button x:Name="TogglePasswordButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="0"
                                ToolTip="显示或隐藏密码"
                                Click="TogglePasswordButton_OnClick">
                            <Path x:Name="EyeIcon"
                                  Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M1,9 C3.8,3.5 14.2,3.5 17,9 C14.2,14.5 3.8,14.5 1,9 Z M9,6.2 A2.8,2.8 0 1 1 9,11.8 A2.8,2.8 0 1 1 9,6.2" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="PasswordTip"
                               Text="修改时留空表示不修改密码"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,6,0,0" />

                    <TextBlock Text="等级（1-5）" Foreground="{StaticResource MutedTextBrush}" Margin="0,18,0,8" />
                    <Slider x:Name="LevelInput"
                            Minimum="1"
                            Maximum="5"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            ValueChanged="LevelInput_OnValueChanged" />
                    <TextBlock x:Name="LevelText" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Content="确认"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Ok_OnClick" />
                    <Button Grid.Column="3"
                            Content="取消"
                            Click="Cancel_OnClick" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
